# Database
DB_URL=jdbc:mysql://localhost:3306/seckill?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
DB_PORT=3306
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=86400000

# Rate Limiting
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX_COUNT=5

# Server
SERVER_PORT=8080

# Logging
LOG_LEVEL=INFO

# Thymeleaf
THYMELEAF_CACHE=false
